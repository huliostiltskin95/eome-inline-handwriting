    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.9.0",
    "jiti": "^2.7.0",
    "obsidian": "1.8.7",
    "tslib": "2.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@ludovicm67/simple-whiteboard": "^0.6.0",
